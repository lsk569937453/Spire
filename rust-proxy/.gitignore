debug/
target/

# Cargo.lock is committed: this is a binary crate, reproducible builds need it.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
rust-proxy
.vscode
*log
temporary
.vscode
log
logs
*.html
*.profraw
.claude

# Plugin build artifacts: compiled components are binaries and are ignored.
# The one exception is the reference plugin's dist/plugin.wasm, kept tracked on
# purpose so `cargo test --features wasm` still runs the real end-to-end round
# trip on a machine with no wasm32-wasip2 target.
*.wasm
!plugins/header-annotator/dist/plugin.wasm
plugins/*/target/

# Profiling/symbol builds used by benchmarks/perf-2026-11 (cross, debug info kept).
/target-pprof/
/target-symbols/
